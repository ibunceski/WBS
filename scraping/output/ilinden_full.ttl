mko:headquarteredIn a owl:ObjectProperty ;
    rdfs:label "headquartered in"@en .

mko:inLanguage a owl:DatatypeProperty ;
    rdfs:label "in language"@en ;
    rdfs:range xsd:string .

mko:locatedInCountry a owl:ObjectProperty ;
    rdfs:label "located in country"@en .

mko:memberOf a owl:ObjectProperty ;
    rdfs:label "member of"@en .

mko:occupation a owl:DatatypeProperty ;
    rdfs:label "occupation"@en ;
    rdfs:range xsd:string .

mko:partOf a owl:ObjectProperty ;
    rdfs:label "part of"@en .

mko:participatedIn a owl:ObjectProperty ;
    rdfs:label "participated in"@en .

mko:startDate a owl:DatatypeProperty ;
    rdfs:label "start date"@en ;
    rdfs:range rdfs:Literal .

mko:tookPlaceIn a owl:ObjectProperty ;
    rdfs:label "took place in"@en .

